# ==============================================================
# Project root guard
#
# This application is meant to be served with the document root pointing at
# public/. Nothing above public/ should ever be reachable over HTTP.
#
# This file is the second line of defence for the very common setup where the
# whole project folder ends up *inside* the document root instead (shared
# hosting that serves public_html/, or XAMPP serving htdocs/). Without it,
# URLs such as /.env or /uploads/papers/<file>.pdf are served as plain files,
# which would leak the mail password, the reCAPTCHA secret and every paper an
# author has submitted.
#
# When public/ really is the document root this file is simply never read,
# because Apache does not look above the document root. It also does nothing
# on nginx, and nothing where AllowOverride is off — so pointing the document
# root at public/ remains the actual fix, not this file.
# ==============================================================

# Never list directory contents.
Options -Indexes

# Dotfiles: .env, .env.example, .gitignore, .claude/ ...
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Files that are never fetched over HTTP, wherever they sit.
<FilesMatch "\.(env|sql|log|ini|bak|sh|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Application internals. uploads/ holds the authors' submitted files, which are
# only ever meant to be served through public/download.php, after that script
# has checked who is asking.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|database|uploads|vendor)(/|$) - [F,L]
</IfModule>
